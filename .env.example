# Copia este archivo como .env y rellena los valores.
# El .env real NO se sube a git (esta en .gitignore).
# Este .env lo usa docker-compose.yml de la raiz.

# ---- General ----
NODE_ENV=development

# ---- MySQL 8 ----
# En local el contenedor arranca con el usuario root y ejecuta
# database/sistema_reservas_upa.sql, que crea la BD `reservas_upa`.
DB_ROOT_PASSWORD=root
DB_NAME=reservas_upa
DB_USER=root
DB_PASSWORD=root
DB_PORT=3306
# TLS obligatorio en Azure Database for MySQL. En local (contenedor) va en false.
DB_SSL=false

# ---- Backend (Node + Express) ----
BACKEND_PORT=4000
JWT_SECRET=clave_secreta_desarrollo_upa
JWT_EXPIRES_IN=8h
CORS_ORIGIN=http://localhost:5173

# ---- Frontend (React + Vite) ----
FRONTEND_PORT=5173
# Es la URL que usa el NAVEGADOR, no la red interna de Docker.
# Vite la resuelve en tiempo de BUILD: si cambia, hay que reconstruir la imagen.
VITE_API_URL=http://localhost:4000/api
